<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MorseMate_Mobile.Translate"
             Title="Translate">
    <VerticalStackLayout>
        <Label 
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Image
            Source="morsealphabet.png"
            HeightRequest="185"
            Aspect="AspectFit"/>

        <Label Text="Enter text to translate:" />
        <Editor
            Text="{Binding TextToTranslate, Mode=TwoWay}"
            Placeholder="Type long notes here..."
            HeightRequest="100" />

        <Editor
             Text="{Binding TranslationOutput}, Mode=TwoWay}"
             Placeholder="Translated text:"
             HeightRequest="100" />

        <!--
        <Label Text="Translated text:" />
        <Label Text="{Binding TranslationOutput}" />
        
        -->

    </VerticalStackLayout>
</ContentPage>